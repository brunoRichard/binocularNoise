@article{Bacon1976,
	abstract = {Binocular interaction was investigated using a psychophysical detection paradigm. A grating with a fixed spatial frequency was presented to one eye and a grating which was varied in spatial frequency and/or phase was presented to the other eye. The results suggest the operation of three distinct processes: one, in which the gratings are matched on a point for point basis; one in which the respective gratings activate independent phase selective channels; and one in which the respective gratings activate independent spatial frequency selective channels. ?? 1976.},
