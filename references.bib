@article{DingLevi2011,
author = {Jian Ding  and Dennis M. Levi },
title = {Recovery of stereopsis through perceptual learning in human adults with abnormal binocular vision},
journal = {Proceedings of the National Academy of Sciences},
volume = {108},
number = {37},
pages = {E733-E741},
year = {2011},
doi = {10.1073/pnas.1105183108},
URL = {https://www.pnas.org/doi/abs/10.1073/pnas.1105183108},
eprint = {https://www.pnas.org/doi/pdf/10.1073/pnas.1105183108},
abstract = {Stereopsis, the perception of depth based on the disparity of the images projected to the retinas of the two eyes, is an important process in our three-dimensional world; however, 3–5\% of the population is stereoblind or has seriously impaired stereovision. Here we provide evidence for the recovery of stereopsis through perceptual learning, the repetitive practice of a demanding visual task, in human adults long deprived of normal binocular vision. We used a training paradigm that combines monocular cues that were correlated perfectly with the disparity cues. Following perceptual learning (thousands of trials) with stereoscopic gratings, five adults who initially were stereoblind or stereoanomalous showed substantial recovery of stereopsis, both on psychophysical tests with stimuli that contained no monocular cues and on clinical testing. They reported that depth “popped out” in daily life, and enjoyed 3D movies for the first time. After training, stereo tests with dynamic random-dot stereograms and band-pass noise revealed the properties of the recovered stereopsis: It has reduced resolution and precision, although it is based on perceiving depth by detecting binocular disparity. We conclude that some human adults deprived of normal binocular vision can recover stereopsis at least partially. Stereoblind or stereodeficient individuals who recover stereopsis may gain substantial benefit in everyday life (5). After achieving stereopsis, our observers reported that depth “popped out” in daily life. They feel more confident in daily tasks that are related to depth perception and are able, for the first time, to enjoy 3D movies. Here we have documented the recovery of stereopsis in human adults with abnormal binocular vision through perceptual learning. We conclude that perceptual learning may provide a useful method for treating stereoblindness and stereoanomalies and that the recovered stereopsis may improve the quality of life in persons with stereo deficiencies. Before training, all stereoblind observers failed the clinical stereo test (\&gt;400 arc seconds); however, after training, they displayed stereoacuities of 40–140 arc seconds on this test. Some consider the appreciation of depth in random dot stereograms to be the gold standard for stereopsis, because the stereograms contain no monocular information that might be used in depth perception. We developed a psychophysical stereo test with high-contrast dynamic random-dot stereograms (DRS) that eliminate any possible monocular cues. With the exception of one abnormal observer, all observers were able to detect depth in our DRS test. A demonstration DRS is available online in Supporting Information. We also examined the properties of the recovered stereopsis and found that it has reduced resolution and precision relative to normal, although it is based on perceiving depth by detecting binocular disparity. After more than 10,000 trials of training, observers with abnormal binocular vision improved their stereo performance substantially and significantly. Indeed, three observers who were stereoblind before training achieved measurable stereopsis through stereo training. The training effect was very limited for normal observers with comparable training. Stereo training began by first establishing binocular fusion and alignment—through which the brain sees a single, unified image for both eyes—by reducing the contrast of the DE's frame (Fig. P1A, Left) until both frames were visible through a stereoscope (Fig. P1A, Left and Center) and adjusting the vertical and horizontal positions of the two frames separately. Once fusion and alignment were achieved (Fig. P1A, Right), two pairs of vertical gratings (Fig. P1B, Left and Center) were presented to the two eyes stereoscopically. The observer's task was to indicate the relative depth of the top grating (i.e., whether it was closer or farther away than the bottom grating) (Fig. P1B, Right). For training, feedback was provided after each trial, and the stimuli contained monocular position cues that were correlated perfectly with binocular disparity cues. To rule out monocular artifacts and ensure that our observers achieved stereopsis, we applied stereo tests with stimuli that contained no monocular cues (pure disparity test) before and after training. Under everyday viewing conditions, individuals with abnormal binocular vision typically view the world through their dominant eye (DE); signals from the other eye, the nondominant eye (NDE), are suppressed strongly in the brain. In the laboratory, however, it is possible to present separate images to each eye through a stereoscope (Fig. P1A). By reducing the contrast of the DE's frame (Fig. P1A, Left) and carefully aligning the images, it is possible for an abnormal observer to perceive both eyes’ images simultaneously (Fig. P1A, Right). In the present study we used a stereoscope to aid eye alignment and perceptual learning to train stereopsis in five adults who were stereoblind or stereoanomalous. Recent studies suggest that perceptual learning may provide an important method for recovery of vision in adults with lazy eye (1). In a few instances, improvement of stereopsis appears to be a side benefit of improving monocular vision through perceptual learning in juveniles with lazy eye (2). Recently, Nakatsuka et al. (3) reported that adult monkeys with mild stereo deficiencies (i.e., that required a larger depth cue than normal) improved their stereoacuity—the ability to detect the smallest depths—through perceptual learning. However, perceptual learning has not been applied directly to the treatment of stereoblindness in human observers. The purpose of the present study was to test whether the recovery of stereopsis can be induced through perceptual learning in human observers who have suffered long-standing stereoblindness, and, if so, what the nature of the recovered stereopsis is. To induce stereopsis, we used a perceptual learning paradigm that combined monocular cues—the relative positions of images in one eye—that were correlated perfectly with the binocular disparity cues; therefore, the monocular and binocular cues are consistent and reinforce each other in the perception of depth (4). Stereopsis, the perception of depth based on the binocular disparity of the images projected to the retinas of the two eyes, adds richness to our perception of our 3D world. However, 3–5\% of the population is stereoblind and is unable to use binocular disparity to perceive depth or has a condition called “stereoanomaly” that results in seriously impaired stereovision. Stereoblindness and stereoanomaly often result from a “turned eye” or “lazy eye” during early childhood. If not treated early enough, these conditions could lead to reduced or no stereopsis. Although treatment is seldom undertaken in adults, we show here that perceptual learning—the repetitive practice of a demanding visual task—can induce the recovery of stereopsis in adults with abnormal binocular vision.}}