@article{Kimetal2011,
   author = {Kim, Y. J. and Grabowecky, M. and Paller, K. A. and Suzuki, S.},
   title = {Differential roles of frequency-following and frequency-doubling visual responses revealed by evoked neural harmonics},
   journal = {J Cogn Neurosci},
   volume = {23},
   number = {8},
   pages = {1875-86},
   note = {1530-8898
Kim, Yee-Joon
Grabowecky, Marcia
Paller, Ken A
Suzuki, Satoru
R01 EY014110/EY/NEI NIH HHS/United States
